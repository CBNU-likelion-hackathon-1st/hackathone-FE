# 백엔드 API base URL.
# production build에서는 비워두면 운영 서버(https://ddangkongi-api.onrender.com)를 사용합니다.
# dev server에서는 CORS 회피를 위해 /api 프록시를 사용합니다.
# dev proxy target을 바꾸려면 .env.local에 VITE_API_PROXY_TARGET을 설정하세요.
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_API_BASE_URL=https://ddangkongi-api.onrender.com
